!==============================================================================
!                                                                             !
! Input parameters can be entered in ANY order, provided that the parameter   !
! KEYWORD (usually, upper case) is typed correctly followed by "="  or "=="   !
! symbols. Any comment lines are allowed and must begin with an exclamation   !
! mark (!) in column one.  Comments may appear to the right of a parameter    !
! specification to improve documentation.  Comments are ignored during        !
! reading.  Blank lines are also allowed and ignored. Continuation lines in   !
! a parameter specification are allowed if preceded by a backslash (\).  In   !
! some instances, more than one value is required for a parameter.  If fewer  !
! values are provided, the last value is assigned for the entire parameter    !
! array.  The multiplication symbol (*),  without blank spaces in between,    !
! is allowed for a parameter specification. For example, in two grids nested  !
! application:                                                                !
!                                                                             !
!    AKT_BAK == 2*1.0d-6  2*5.0d-6              ! m2/s                        !
!                                                                             !
! indicates that the first two entries of array AKT_BAK,  in fortran column-  !
! major order, will have the same value of "1.0d-6" for grid 1,  whereas the  !
! next two entries will have the same value of "5.0d-6" for grid 2.           !
!                                                                             !
! In multiple levels of nesting or multiple connected domains step-ups,       !
! "Ngrids" entries are expected for some of these parameters. In such case,   !
! the order of the entries for a parameter is critical. It must follow the    !
! same order (1:Ngrids) as in the state variable declaration. The USER may    !
! follow the above guidelines for specifying his/her values. These parameters !
! are marked by "==" plural symbol after the KEYWORD.                         !
!                                                                             !
!==============================================================================
!
! Set lateral boundary conditions keyword. Notice that a value is expected
! for each boundary segment per nested grid for each state variable.
!
! Each tracer variable requires [1:4,1:NAT+NPT,Ngrids] values. Otherwise,
! [1:4,1:Ngrids] values are expected for other variables. The boundary
! order is: 1=west, 2=south, 3=east, and 4=north. That is, anticlockwise
! starting at the western boundary.
!
! The keyword is case insensitive and usually has three characters. However,
! it is possible to have compound keywords, if applicable. For example, the
! keyword "RadNud" implies radiation boundary condition with nudging. This
! combination is usually used in active/passive radiation conditions.
!
!   Keyword    Lateral Boundary Condition Type
!                                                     _____N_____     j=Mm
!    Cla        Clamped                              |     4     |
!    Clo        Closed                               |           |
!    Gra        Gradient                           1 W           E 3
!    Nud        Nudging                              |           |
!    Per        Periodic                             |_____S_____|
!    Rad        Radiation                                  2          j=1
!                                                   i=1         i=Lm
!
!                   W       S       E       N
!                   e       o       a       o
!                   s       u       s       r
!                   t       t       t       t
!                           h               h
!
!                   1       2       3       4

   LBC(isIhis) ==   Clo     Clo     Clo     Clo         ! thickness
   LBC(isIuis) ==   Clo     Clo     Clo     Clo         ! U-velocity
   LBC(isIvis) ==   Clo     Clo     Clo     Clo         ! V-velocity
   LBC(isItis) ==   Clo     Clo     Clo     Clo         ! temperature

! C value (Drho/Dz) in Zhou and Hatterman (2020) [kg/m4].

    isf_drdz == 0.00478

! Iceshelf Ustar scaling factor [non-dimensional].

        gamU == 1.0d0

! Iceshelf Ustar minimum value [m/s]. 8.0d-6 for diffusion only,
! 1.0d-3 for diffusion + tidal forcing.

   min_ustar == 8.0d-6

! Logical switches for iceshelf-ocean tracer exchange.

  LtracerIsf == T     ! dye_01, ...        inert passive tracers

! Logical switches for iceshelf melt water tracer source.

  LsourceIsf == T     ! dye_01, ...        inert passive tracers

! Iceshelf melt water tracer concentration.

      trcIsf == 1.0d0 ! dye_01, ...        inert passive tracers

! Logical switches (TRUE/FALSE) to activate writing of iceshelf
! variables into HISTORY output file.

Hout(idIhis) == T     ! Si(...,isIhis)     iceshelf thickness
Hout(idIuis) == T     ! Si(...,isIuis)     iceshelf U-velocity
Hout(idIvis) == T     ! Si(...,isIvis)     iceshelf V-velocity
Hout(idIuer) == T     !                    iceshelf eastward velocity
Hout(idIvnr) == T     !                    iceshelf northward velocity
Hout(idItis) == T     ! Si(...,isItis)     iceshelf temperature
Hout(idIeis) == T     ! Si(...,isIeis)     iceshelf enthalpy

Hout(idImel) == T     ! Fi(...,icImel)     iceshelf basal melt rate
Hout(idIgat) == T     ! Fi(...,icItat)     iceshelf gammaT
Hout(idIgas) == T     ! Fi(...,icIgas)     iceshelf gammaS
Hout(idItst) == T     ! Fi(...,icItst)     iceshelf Tstar
Hout(idIust) == T     ! Fi(...,icIust)     iceshelf Ustar
Hout(idItbo) == T     ! Fi(...,icItbo)     iceshelf boundary layer temperature
Hout(idIsbo) == T     ! Fi(...,icIsbo)     iceshelf boundary layer salinity

Hout(idIvol) == T     ! Vi                 iceshelf refreezed volume
Hout(idItrc) == T     ! Ti(...,itrc)       iceshelf refreezed tracer

! Logical switches (TRUE/FALSE) to activate writing of iceshelf
! variables into QUICKSAVE output file.

Qout(idIhis) == T     ! Si(...,isIhis)     iceshelf thickness
Qout(idIuis) == T     ! Si(...,isIuis)     iceshelf U-velocity
Qout(idIvis) == T     ! Si(...,isIvis)     iceshelf V-velocity
Qout(idIuer) == T     !                    iceshelf eastward velocity
Qout(idIvnr) == T     !                    iceshelf northward velocity
Qout(idItis) == T     ! Si(...,isItis)     iceshelf temperature
Qout(idIeis) == T     ! Si(...,isIeis)     iceshelf enthalpy

Qout(idImel) == T     ! Fi(...,icImel)     iceshelf basal melt rate
Qout(idIgat) == T     ! Fi(...,icItat)     iceshelf gammaT
Qout(idIgas) == T     ! Fi(...,icIgas)     iceshelf gammaS
Qout(idItst) == T     ! Fi(...,icItst)     iceshelf Tstar
Qout(idIust) == T     ! Fi(...,icIust)     iceshelf Ustar
Qout(idItbo) == T     ! Fi(...,icItbo)     iceshelf boundary layer temperature
Qout(idIsbo) == T     ! Fi(...,icIsbo)     iceshelf boundary layer salinity

Qout(idIvol) == T     ! Vi                 iceshelf refreezed volume
Qout(idItrc) == T     ! Ti(...,itrc)       iceshelf refreezed tracer

! Logical switches (TRUE/FALSE) to activate writing of iceshelf
! variables into AVERAGES output file.

Aout(idIhis) == T     ! Si_avg(...,isIhis) iceshelf thickness
Aout(idIuis) == T     ! Si_avg(...,isIuis) iceshelf U-velocity
Aout(idIvis) == T     ! Si_avg(...,isIvis) iceshelf V-velocity
Aout(idIuer) == T     !                    iceshelf eastward velocity
Aout(idIvnr) == T     !                    iceshelf northward velocity
Aout(idItis) == T     ! Si_avg(...,isItis) iceshelf temperature
Aout(idIeis) == T     ! Si_avg(...,isIeis) iceshelf enthalpy

Aout(idImel) == T     ! Fi_avg(...,icImel) iceshelf basal melt rate
Aout(idIgat) == T     ! Fi_avg(...,icItat) iceshelf gammaT
Aout(idIgas) == T     ! Fi_avg(...,icIgas) iceshelf gammaS
Aout(idItst) == T     ! Fi_avg(...,icItst) iceshelf Tstar
Aout(idIust) == T     ! Fi_avg(...,icIust) iceshelf Ustar
Aout(idItbo) == T     ! Fi_avg(...,icItbo) iceshelf boundary layer temperature
Aout(idIsbo) == T     ! Fi_avg(...,icIsbo) iceshelf boundary layer salinity

Aout(idIvol) == T     ! Vi_avg             iceshelf refreezed volume
Aout(idItrc) == T     ! Ti_avg(...,itrc)   iceshelf refreezed tracer

! Logical switches (TRUE/FALSE) to activate writing of iceshelf
! variables into STATION output file.

Sout(idIhis) == T     ! Si(...,isIhis)     iceshelf thickness
Sout(idIuis) == T     ! Si(...,isIuis)     iceshelf U-velocity
Sout(idIvis) == T     ! Si(...,isIvis)     iceshelf V-velocity
Sout(idIuer) == T     !                    iceshelf eastward velocity
Sout(idIvnr) == T     !                    iceshelf northward velocity
Sout(idItis) == T     ! Si(...,isItis)     iceshelf temperature
Sout(idIeis) == T     ! Si(...,isIeis)     iceshelf enthalpy

Sout(idImel) == T     ! Fi(...,icImel)     iceshelf basal melt rate
Sout(idIgat) == T     ! Fi(...,icItat)     iceshelf gammaT
Sout(idIgas) == T     ! Fi(...,icIgas)     iceshelf gammaS
Sout(idItst) == T     ! Fi(...,icItst)     iceshelf Tstar
Sout(idIust) == T     ! Fi(...,icIust)     iceshelf Ustar
Sout(idItbo) == T     ! Fi(...,icItbo)     iceshelf boundary layer temperature
Sout(idIsbo) == T     ! Fi(...,icIsbo)     iceshelf boundary layer salinity

Sout(idIvol) == T     ! Vi                 iceshelf refreezed volume
Sout(idItrc) == T     ! Ti(...,itrc)       iceshelf refreezed tracer


!
!  GLOSSARY:
!  =========
!
!------------------------------------------------------------------------------
! Lateral boundary conditions parameters.
!------------------------------------------------------------------------------
!
! The lateral boundary conditions are now specified with logical switches
! instead of CPP flags to allow nested grid configurations. Their values are
! loaded into structured array:
!
!    LBC(1:4, nLBCvar, Ngrids)
!
! where 1:4 are the number of boundary edges, nLBCvar are the number of LBC
! state variables, and Ngrids is the number of nested grids. For Example, to
! apply gradient boundary conditions we use:
!
!    LBC(iwest,  isAice, ng) % gradient
!    LBC(ieast,  ...   , ng) % gradient
!    LBC(isouth, ...   , ng) % gradient
!    LBC(inorth, ...   , ng) % gradient
!
! The lateral boundary conditions are entered with a keyword. This keyword
! is case insensitive and usually has three characters. However, it is
! possible to have compound keywords, if applicable. For example, the
! keyword "RadNud" implies radiation boundary condition with nudging. This
! combination is usually used in active/passive radiation conditions.
!
!   Keyword    Lateral Boundary Condition Type
!
!   Clo        Closed                                 _____N_____     j=Mm
!   Clo        Clamped                               |     4     |
!   Gra        Gradient                              |           |
!   Rad        Radiation                           1 W           E 3
!   RadNud     Radiation Nudging                     |           |
!   Mix        Mixed (clamped/gradient)              |_____S_____|
!   Per        Periodic                                    2          j=1
!   Nes        Nested (refinement, not avail yet)   i=1         i=Lm
!
!------------------------------------------------------------------------------
!  Iceshelf model parameters.
!------------------------------------------------------------------------------
!
!  isf_drdz       C value (Drho/Dz) in Zhou and Hatterman (2020) [kg/m4].
!
!  gamU           Iceshelf Ustar scaling factor.
!
!  min_ustar      Iceshelf Ustar minimum value. 8.0d-6 for diffusion only,
!                   1.0d-3 for diffusion + tidal forcing.
!
!  LtracerIsf     Logical switches for iceshelf melt water passive tracers.
!
!------------------------------------------------------------------------------
! Logical switches (T/F) to activate writing of instantaneous ice fields into
! HISTORY file.
!------------------------------------------------------------------------------
!
! Hout(idIhis)    Write out iceshelf thickness.
! Hout(idIuis)    Write out iceshelf U-velocity.
! Hout(idIvis)    Write out iceshelf V-velocity.
! Hout(idIuer)    Write out iceshelf eastward velocity.
! Hout(idIvnr)    Write out iceshelf northward velocity.
! Hout(idItis)    Write out iceshelf temperature.
! Hout(idIeis)    Write out iceshelf enthalpy.
!
! Hout(idImel)    Write out iceshelf basal melt rate.
! Hout(idIgat)    Write out iceshelf gammaT.
! Hout(idIgas)    Write out iceshelf gammaS.
! Hout(idItst)    Write out iceshelf Tstar.
! Hout(idIust)    Write out iceshelf Ustar.
! Hout(idItbo)    Write out iceshelf boundary layer temperature.
! Hout(idIsbo)    Write out iceshelf boundary layer salinity.
!
! Hout(idIvol)    Write out iceshelf refreezed volume.
! Hout(idItrc)    Write out iceshelf refreezed passive tracer.
!
!------------------------------------------------------------------------------
! Logical switches (T/F) to activate writing of instantaneous ice fields into
! QUICKSAVE file.
!------------------------------------------------------------------------------
!
! Qout(idIhis)    Write out iceshelf thickness.
! Qout(idIuis)    Write out iceshelf U-velocity.
! Qout(idIvis)    Write out iceshelf V-velocity.
! Qout(idIuer)    Write out iceshelf eastward velocity.
! Qout(idIvnr)    Write out iceshelf northward velocity.
! Qout(idItis)    Write out iceshelf temperature.
! Qout(idIeis)    Write out iceshelf enthalpy.
!
! Qout(idImel)    Write out iceshelf basal melt rate.
! Qout(idIgat)    Write out iceshelf gammaT.
! Qout(idIgas)    Write out iceshelf gammaS.
! Qout(idItst)    Write out iceshelf Tstar.
! Qout(idIust)    Write out iceshelf Ustar.
! Qout(idItbo)    Write out iceshelf boundary layer temperature.
! Qout(idIsbo)    Write out iceshelf boundary layer salinity.
!
! Qout(idIvol)    Write out iceshelf refreezed volume.
! Qout(idItrc)    Write out iceshelf refreezed passive tracer.
!
!------------------------------------------------------------------------------
! Logical switches (T/F) to activate writing of time-averaged ice fields into
! AVERAGE file.
!------------------------------------------------------------------------------
!
! Aout(idIhis)    Write out iceshelf thickness.
! Aout(idIuis)    Write out iceshelf U-velocity.
! Aout(idIvis)    Write out iceshelf V-velocity.
! Aout(idIuer)    Write out iceshelf eastward velocity.
! Aout(idIvnr)    Write out iceshelf northward velocity.
! Aout(idItis)    Write out iceshelf temperature.
! Aout(idIeis)    Write out iceshelf enthalpy.
!
! Aout(idImel)    Write out iceshelf basal melt rate.
! Aout(idIgat)    Write out iceshelf gammaT.
! Aout(idIgas)    Write out iceshelf gammaS.
! Aout(idItst)    Write out iceshelf Tstar.
! Aout(idIust)    Write out iceshelf Ustar.
! Aout(idItbo)    Write out iceshelf boundary layer temperature.
! Aout(idIsbo)    Write out iceshelf boundary layer salinity.
!
! Aout(idIvol)    Write out iceshelf refreezed volume.
! Aout(idItrc)    Write out iceshelf refreezed passive tracer.
!
!------------------------------------------------------------------------------
! Logical switches (T/F) to activate writing of time-averaged ice fields into
! STATION file.
!------------------------------------------------------------------------------
!
! Sout(idIhis)    Write out iceshelf thickness.
! Sout(idIuis)    Write out iceshelf U-velocity.
! Sout(idIvis)    Write out iceshelf V-velocity.
! Sout(idIuer)    Write out iceshelf eastward velocity.
! Sout(idIvnr)    Write out iceshelf northward velocity.
! Sout(idItis)    Write out iceshelf temperature.
! Sout(idIeis)    Write out iceshelf enthalpy.
!
! Sout(idImel)    Write out iceshelf basal melt rate.
! Sout(idIgat)    Write out iceshelf gammaT.
! Sout(idIgas)    Write out iceshelf gammaS.
! Sout(idItst)    Write out iceshelf Tstar.
! Sout(idIust)    Write out iceshelf Ustar.
! Sout(idItbo)    Write out iceshelf boundary layer temperature.
! Sout(idIsbo)    Write out iceshelf boundary layer salinity.
!
! Sout(idIvol)    Write out iceshelf refreezed volume.
! Sout(idItrc)    Write out iceshelf refreezed passive tracer.
!
